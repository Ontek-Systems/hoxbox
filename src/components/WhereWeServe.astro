---
import PencilUnderline from "./PencilUnderline.astro";

// Centred header (Gallery/WhatWeDo pattern) + an auto-scrolling pill carousel
// of the towns/areas covered, followed by a full-width Leaflet map.
// Leaflet over Google Maps per project decision; map style follows the
// Marshall & Co reference: flat CARTO basemap, one coverage polygon, one pin.
// Each group's first entry is the region itself (Hertfordshire, North London,
// Central London), rendered as an accent pill; the rest are towns/areas
// within it, all confirmed Hertfordshire/Greater London locations.
const groups = [
	{
		region: "Hertfordshire",
		towns: ["St Albans", "Watford", "Hemel Hempstead", "Hertford", "Stevenage", "Welwyn Garden City", "Hatfield", "Borehamwood"],
	},
	{
		region: "North London",
		towns: ["Islington", "Hackney", "Camden", "Enfield", "Barnet", "Finchley", "Highgate", "Muswell Hill"],
	},
	{
		region: "Central London",
		towns: ["Shoreditch", "Clerkenwell", "Fitzrovia", "Marylebone", "Soho", "Covent Garden", "City of London", "Holborn"],
	},
];

const locations = groups.flatMap((group) => [
	{ name: group.region, isRegion: true },
	...group.towns.map((name) => ({ name, isRegion: false })),
]);
---

<div class="where-we-serve__divider" aria-hidden="true"></div>

<section class="where-we-serve" id="where-we-serve">
	<div class="where-we-serve__header">
		<p class="where-we-serve__eyebrow">
			<span>Where we work</span><PencilUnderline color="var(--color-division-design-build)" thickness={2} />
		</p>
		<h2 class="where-we-serve__title">Areas we cover</h2>
	</div>

	<div class="where-we-serve__carousel" data-carousel aria-label="Towns and areas we cover">
		<div class="where-we-serve__carousel-track" data-carousel-track>
			{
				[...locations, ...locations].map((location, i) => (
					<span class="where-we-serve__pill" aria-hidden={i >= locations.length ? "true" : undefined}>
						{location.name}
					</span>
				))
			}
		</div>
	</div>

	<div class="where-we-serve__map-wrap">
		<div class="where-we-serve__map" data-serve-map role="img" aria-label="Map showing Hox Box's coverage across Hertfordshire, North London and Central London"></div>
	</div>

	<div class="where-we-serve__cta">
		<a class="where-we-serve__button" href="/contact">
			<span class="where-we-serve__button-bg" aria-hidden="true"></span>
			<span class="where-we-serve__button-edge" aria-hidden="true"></span>
			<span class="where-we-serve__button-label" data-label="Get in touch">Get in touch</span>
		</a>
	</div>
</section>

<script>
	// JS-driven marquee (rather than a CSS animation) so hovering can ease the
	// speed down to a crawl instead of an instant animation-play-state stop.
	const carousel = document.querySelector<HTMLElement>("[data-carousel]");
	const track = document.querySelector<HTMLElement>("[data-carousel-track]");
	const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	if (carousel && track && !reduceMotion) {
		let loopWidth = track.scrollWidth / 2;
		const baseSpeed = loopWidth / 42000; // px/ms, matches the site's previous 42s loop
		const hoverSpeed = baseSpeed * 0.12;
		let currentSpeed = baseSpeed;
		let targetSpeed = baseSpeed;
		let position = 0;
		let lastTime: number | null = null;

		carousel.addEventListener("mouseenter", () => {
			targetSpeed = hoverSpeed;
		});
		carousel.addEventListener("mouseleave", () => {
			targetSpeed = baseSpeed;
		});
		window.addEventListener("resize", () => {
			loopWidth = track.scrollWidth / 2;
		});

		function frame(time: number) {
			if (lastTime === null) lastTime = time;
			const dt = time - lastTime;
			lastTime = time;

			// Ease current speed toward the target over ~600ms, so hover/unhover
			// decelerates and accelerates smoothly rather than snapping.
			currentSpeed += (targetSpeed - currentSpeed) * Math.min(1, dt / 600);
			position -= currentSpeed * dt;
			if (position <= -loopWidth) position += loopWidth;

			track.style.transform = `translateX(${position}px)`;
			requestAnimationFrame(frame);
		}

		requestAnimationFrame(frame);
	}
</script>

<style>
	.where-we-serve__divider {
		height: 1px;
		width: 100%;
		background: linear-gradient(
			to right,
			var(--color-bg-light) 0%,
			color-mix(in srgb, var(--color-graphite) 60%, var(--color-bg-light)) 50%,
			var(--color-bg-light) 100%
		);
	}

	.where-we-serve {
		box-sizing: border-box;
		background: var(--color-bg-light);
		color: var(--color-text);
		padding-bottom: var(--section-pad-y);
	}

	.where-we-serve__header {
		max-width: 40rem;
		margin: 0 auto;
		padding: var(--section-pad-y) var(--space-4) var(--space-5);
		text-align: center;
	}

	.where-we-serve__eyebrow {
		position: relative;
		display: inline-block;
		width: fit-content;
		font-size: calc(var(--text-xs) * 0.85);
		font-weight: 700;
		letter-spacing: 0.207em;
		text-transform: uppercase;
		color: var(--color-text);
		margin: 0 0 var(--space-4);
	}

	.where-we-serve__title {
		font-family: var(--font-display);
		font-size: clamp(1.9rem, 3.2vw, var(--text-3xl));
		text-transform: uppercase;
		line-height: var(--leading-tight);
		color: var(--color-text);
		margin: 0;
	}

	/* Carousel: speed is driven by JS (see script below) so hovering can ease
	   the marquee down to a crawl instead of snapping to a hard stop. */
	.where-we-serve__carousel {
		overflow: hidden;
		max-width: 1440px;
		margin: 0 auto;
		mask-image: linear-gradient(to right, transparent 0, #000 3rem, #000 calc(100% - 3rem), transparent 100%);
		padding: 0 0 var(--space-5);
	}

	.where-we-serve__carousel-track {
		display: flex;
		width: fit-content;
		gap: var(--space-3);
		will-change: transform;
	}

	.where-we-serve__pill {
		flex-shrink: 0;
		position: relative;
		border-left: 2px solid var(--color-division-design-build);
		padding: 0.6rem 1.25rem;
		font-size: var(--text-xs);
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: #fff;
		background: var(--color-graphite);
		white-space: nowrap;
		transition: background 250ms var(--ease-standard), border-color 250ms var(--ease-standard);
	}

	.where-we-serve__pill:hover {
		background: var(--color-division-design-build);
		border-left-color: var(--color-graphite);
	}

	@media (prefers-reduced-motion: reduce) {
		.where-we-serve__carousel {
			overflow-x: auto;
		}
	}

	/* Map */
	.where-we-serve__map-wrap {
		max-width: 1440px;
		margin: 0 auto var(--space-5);
		padding: 0 clamp(2rem, 4.5vw, 4rem);
		box-sizing: border-box;
	}

	.where-we-serve__map {
		position: relative;
		isolation: isolate;
		width: 100%;
		height: clamp(24rem, 40.8vw, 33.6rem);
	}

	.where-we-serve__cta {
		display: flex;
		justify-content: center;
		max-width: 1440px;
		margin: 0 auto;
		padding: 0 clamp(2rem, 4.5vw, 4rem);
		box-sizing: border-box;
	}

	/* Button: copied verbatim from Intro.astro's dark button pattern. */
	.where-we-serve__button {
		--btn-pad: 0.75rem 1.5rem;
		position: relative;
		display: inline-flex;
		width: fit-content;
		background: var(--color-division-design-build);
		color: #fff;
		text-decoration: none;
		overflow: hidden;
		isolation: isolate;
	}

	.where-we-serve__button-bg {
		position: absolute;
		inset: 0;
		width: 2px;
		background: var(--color-graphite);
		transition: width 350ms var(--ease-standard);
		z-index: 0;
	}

	.where-we-serve__button:hover .where-we-serve__button-bg,
	.where-we-serve__button:focus-visible .where-we-serve__button-bg {
		width: 100%;
	}

	.where-we-serve__button-edge {
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 2px;
		background: var(--color-division-design-build);
		opacity: 0;
		z-index: 1;
		transition: opacity 350ms var(--ease-standard);
	}

	.where-we-serve__button:hover .where-we-serve__button-edge,
	.where-we-serve__button:focus-visible .where-we-serve__button-edge {
		opacity: 1;
	}

	.where-we-serve__button-label {
		position: relative;
		z-index: 1;
		display: inline-flex;
		align-items: center;
		font-size: var(--text-xs);
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		padding: var(--btn-pad);
		white-space: nowrap;
		transition: transform 150ms var(--ease-standard);
	}

	.where-we-serve__button-label::after {
		content: attr(data-label);
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		padding: var(--btn-pad);
		color: #fff;
		clip-path: inset(0 100% 0 0);
		transition: clip-path 350ms var(--ease-standard);
		pointer-events: none;
	}

	.where-we-serve__button:hover .where-we-serve__button-label::after,
	.where-we-serve__button:focus-visible .where-we-serve__button-label::after {
		clip-path: inset(0 0 0 0);
	}

	.where-we-serve__button:active .where-we-serve__button-label {
		transform: scale(0.97);
	}

	@media (max-width: 1024px) {
		.where-we-serve__map {
			height: 21.6rem;
		}
	}
</style>

<script>
	import L from "leaflet";
	import "leaflet/dist/leaflet.css";

	const mapEl = document.querySelector<HTMLElement>("[data-serve-map]");

	if (mapEl) {
		const map = L.map(mapEl, {
			scrollWheelZoom: false,
			zoomControl: true,
			attributionControl: true,
		});

		L.tileLayer("https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png", {
			attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
			maxZoom: 19,
		}).addTo(map);

		// Rough coverage outline across Hertfordshire, North London and Central London.
		// Flat north edge sits level with Luton, doesn't extend past it.
		const coverage: [number, number][] = [
			[51.87, -0.55],
			[51.87, -0.05],
			[51.72, 0.15],
			[51.58, 0.05],
			[51.46, -0.05],
			[51.44, -0.25],
			[51.58, -0.55],
		];

		const coveragePolygon = L.polygon(coverage, {
			color: "#d4302f",
			weight: 2,
			fillColor: "#d4302f",
			fillOpacity: 0.15,
		}).addTo(map);

		const baseIcon = L.divIcon({
			className: "serve-marker",
			html: '<span class="serve-marker__dot"></span>',
			iconSize: [16, 16],
			iconAnchor: [8, 8],
		});

		L.marker([51.5326, -0.0765], { icon: baseIcon }).addTo(map);

		// Frame the map to the coverage area itself, rather than a fixed zoom
		// level, so it fills the full-width container correctly regardless of
		// viewport size (a fixed zoom looked far too zoomed out on wide screens).
		map.fitBounds(coveragePolygon.getBounds(), { padding: [40, 40] });

		map.on("focus", () => map.scrollWheelZoom.enable());
		map.on("blur", () => map.scrollWheelZoom.disable());
	}
</script>

<style is:global>
	.serve-marker {
		background: transparent;
		border: none;
	}

	.serve-marker__dot {
		display: block;
		width: 14px;
		height: 14px;
		border-radius: 50%;
		background: #d4302f;
		border: 2px solid #fff;
	}

	/* Boost the muted CARTO Positron basemap's parks/water saturation and
	   push contrast/brightness harder so land vs. water actually reads,
	   without pulling in Voyager's orange/yellow road colouring. */
	.where-we-serve__map .leaflet-tile-pane {
		filter: saturate(1.6) contrast(1.05);
	}

	.where-we-serve__map .leaflet-container {
		outline: none;
		background: var(--color-bg-light);
	}

	/* Leaflet's default pane/control z-index stack (400-1000) is scoped by
	   isolation:isolate on the map wrapper, but keep controls below the
	   sticky nav (z-index:100) too in case that isolation is ever removed. */
	.where-we-serve__map .leaflet-pane,
	.where-we-serve__map .leaflet-top,
	.where-we-serve__map .leaflet-bottom {
		z-index: 10;
	}

	.leaflet-control-attribution {
		font-size: 0.65rem;
	}
</style>
