---
import PencilUnderline from "./PencilUnderline.astro";

// Locked division accent colors — do not change without sign-off.
// Design & Build is the brand's own fixed red; the other four are
// sampled directly from that division's logo wordmark fill and must
// stay in sync with the SVGs in public/logo/.
//   design-build: #d4302f
//   furniture:     #ed4693
//   joinery:       #f6e31b
//   plants:        #32b62b
//   signage:       #16ace4
const navDropdownOrder = ["design-build", "furniture", "joinery", "plants", "signage"];

// Short one-liners for the mobile menu's division grid — sourced verbatim from
// Footer.astro so the two stay in sync without importing state across components.
const divisions = [
	{
		id: "design-build",
		accent: "#d4302f",
		image: "/images/Hero Images/design & build_hero.jpg",
			logoSub: "/logo/design-build-white.svg",
		eyebrow: "HOX BOX DESIGN & BUILD",
		title: "Integrity, reliability, and performance.",
		body: "One in-house team, every stage covered, pre-construction to handover, delivered around 30% quicker than the traditional route, fuss-free from start to finish.",
		cta: "View our projects",
		href: "/projects",
	},
	{
		id: "furniture",
		accent: "#ed4693",
		image: "/images/Hero Images/Furniture_hero.jpg",
		imagePosition: "75% center",
			logoSub: "/logo/furniture.svg",
		eyebrow: "HOX BOX FURNITURE",
		title: "Furniture, sourced with care",
		body: "Direct contact with wholesalers across the UK and Europe, a personable, transparent service from selection to installation.",
		cta: "Explore furniture",
		href: "/furniture",
	},
	{
		id: "plants",
		accent: "#32b62b",
		image: "/images/Hero Images/plants_hero.jpg",
			logoSub: "/logo/plants.svg",
		eyebrow: "HOX BOX PLANTS",
		title: "Greenery that needs no upkeep",
		body: "A design-led, no-maintenance alternative to living plants, from 2m trees to small counter displays.",
		cta: "Browse plants",
		href: "/plants",
	},
	{
		id: "joinery",
		accent: "#f6e31b",
		image: "/images/Hero Images/Joinery_hero.jpg",
			logoSub: "/logo/joinery.svg",
		eyebrow: "HOX BOX JOINERY",
		title: "Bespoke joinery, built in-house",
		body: "Kitchens, wardrobes, doors and specialist cabinetry, manufactured, assembled and finished off-site before we install.",
		cta: "See our joinery",
		href: "/joinery",
	},
	{
		id: "signage",
		accent: "#16ace4",
		image: "/images/Hero Images/Signage_hero.jpg",
			logoSub: "/logo/signage.svg",
		eyebrow: "HOX BOX SIGNAGE",
		title: "Signage that speaks for your brand",
		body: "Lightboxes, acrylic lettering, vinyl graphics and wayfinding, designed in-house and fitted by our own team.",
		cta: "View signage",
		href: "/signage",
	},
];
---

<section
	class="hero"
	id="hero"
	data-active={divisions[0].id}
	data-divisions-json={JSON.stringify(divisions)}
	style={`--accent:${divisions[0].accent}`}
>
	<div class="hero__bg">
		{divisions.map((d, i) => (
			<div
				class="hero__slide"
				data-slide={d.id}
				data-active={i === 0 ? "true" : "false"}
				style={`--slide-color:${d.accent};--slide-image:url("${d.image}");--slide-position:${d.imagePosition ?? "center"}`}
			>
			</div>
		))}
	</div>
	<div class="hero__edge-top"></div>
	<div class="hero__edge-bottom"></div>
	<div class="hero__edge-left"></div>

	<header class="hero__nav">
		<a class="hero__logo" href="/">
			<img class="hero__logo-word" src="/logo/hoxbox-main-white.svg" alt="Hox Box" />
			<span class="hero__logo-sub" data-logo-sub>
				{divisions.map((d, i) => (
					<img
						class="hero__logo-sub-img"
						data-logo-img={d.id}
						data-active={i === 0 ? "true" : "false"}
						src={d.logoSub}
						alt={d.eyebrow}
					/>
				))}
			</span>
		</a>
		<nav class="hero__nav-links" aria-label="Primary">
			<div class="hero__nav-group hero__nav-group--left">
				<a href="/about">About Us</a>
				<a href="/gallery">Gallery</a>
			</div>
			<div class="hero__dropdown" data-dropdown>
				<button
					type="button"
					class="hero__dropdown-trigger"
					aria-haspopup="true"
					aria-expanded="false"
					data-dropdown-trigger
				>
					What We Do
					<span class="hero__dropdown-caret" aria-hidden="true"></span>
				</button>
				<div class="hero__dropdown-panel" role="menu">
					{navDropdownOrder.map((id) => {
						const d = divisions.find((division) => division.id === id)!;
						return (
							<a
								href={d.href}
								role="menuitem"
								class="hero__dropdown-item"
								style={`--item-accent:${d.accent}`}
							>
								<span class="hero__dropdown-swatch" aria-hidden="true"></span>
								{d.eyebrow.replace("HOX BOX ", "")}
							</a>
						);
					})}
				</div>
			</div>
			<div class="hero__nav-group hero__nav-group--right">
				<a href="/testimonials">Testimonials</a>
				<a href="/case-studies">Case Studies</a>
			</div>
		</nav>
		<a class="hero__button hero__cta-nav" href="/contact">
			<span class="hero__button-bg" aria-hidden="true"></span>
			<span class="hero__button-edge" aria-hidden="true"></span>
			<span class="hero__button-label" data-label="Get in touch">Get in touch</span>
		</a>

		<button
			type="button"
			class="hero__burger"
			aria-haspopup="true"
			aria-expanded="false"
			aria-label="Open menu"
			data-burger-trigger
		>
			<span class="hero__burger-bar"></span>
			<span class="hero__burger-bar"></span>
			<span class="hero__burger-bar"></span>
		</button>
	</header>

	<div class="hero__mobile-panel" data-mobile-panel role="menu">
		<div class="hero__mobile-panel-scroll">
			<nav class="hero__mobile-panel-primary" aria-label="Secondary">
				<a href="/about" role="menuitem">About Us</a>
				<a href="/gallery" role="menuitem">Gallery</a>
				<a href="/testimonials" role="menuitem">Testimonials</a>
				<a href="/case-studies" role="menuitem">Case Studies</a>
				<a href="/contact" role="menuitem" class="hero__mobile-panel-cta">Get in touch</a>
			</nav>

			<ul class="hero__mobile-panel-divisions">
				{navDropdownOrder.map((id) => {
					const d = divisions.find((division) => division.id === id)!;
					return (
						<li>
							<a href={d.href} role="menuitem" class="hero__mobile-panel-division" style={`--division-color:${d.accent}`}>
								<span class="hero__mobile-panel-division-bar" aria-hidden="true"></span>
								<p class="hero__mobile-panel-division-name">{d.eyebrow.replace("HOX BOX ", "")}</p>
							</a>
						</li>
					);
				})}
			</ul>
		</div>
	</div>

	<div class="hero__content">
		<div class="hero__copy" data-copy>
			<div class="hero__copy-text">
				<p class="hero__eyebrow">
					<span data-field="eyebrow">{divisions[0].eyebrow}</span><PencilUnderline color="var(--accent)" thickness={2} />
				</p>
				<h1 class="hero__title" data-field="title">{divisions[0].title}</h1>
				<p class="hero__body" data-field="body">{divisions[0].body}</p>
			</div>
			<a class="hero__button" data-field="cta" href={divisions[0].href}>
				<span class="hero__button-bg" aria-hidden="true"></span>
				<span class="hero__button-edge" aria-hidden="true"></span>
				<span class="hero__button-label" data-field="cta-label" data-label={divisions[0].cta}>{divisions[0].cta}</span>
			</a>
		</div>
	</div>

	<div class="hero__footer">
		<div class="hero__mobile-indicator" data-mobile-indicator>
			<span class="hero__mobile-indicator-line"></span>
			<div class="hero__mobile-indicator-row">
				<span class="hero__mobile-indicator-label" data-field="mobile-label">{divisions[0].eyebrow.replace("HOX BOX ", "")}</span>
				<a class="hero__mobile-indicator-arrow" data-field="mobile-arrow" href={divisions[0].href} aria-label={`Go to ${divisions[0].eyebrow}`}>
					<span aria-hidden="true">&#8599;</span>
				</a>
			</div>
		</div>

		<div class="hero__divisions" data-divisions>
			<div class="hero__divisions-track">
				<span class="hero__divisions-line"></span>
				<span class="hero__indicator" data-indicator></span>
			</div>
			<ul class="hero__division-list">
				{divisions.map((d, i) => (
					<li
						data-item={d.id}
						data-pinned={i === 0 ? "true" : "false"}
						style={`--fill:${i === 0 ? 1 : 0};--arrow-fill:${i === 0 ? 1 : 0}`}
					>
						<div class="hero__division-inner">
							<button
								type="button"
								class="hero__division-btn"
								data-division={d.id}
								data-index={i}
								aria-current={i === 0 ? "true" : "false"}
							>
								<span class="hero__division-label">{d.eyebrow.replace("HOX BOX ", "")}</span>
							</button>
							<a
								class="hero__division-arrow"
								href={d.href}
								data-arrow={d.id}
								aria-label={`Go to ${d.eyebrow}`}
								tabindex="-1"
							>
								<span class="hero__division-arrow-glyph">&#8599;</span>
							</a>
						</div>
					</li>
				))}
			</ul>
		</div>

		<div class="hero__scroll">
			<span class="hero__scroll-line"></span>
			<span>Scroll to discover more</span>
		</div>
	</div>
</section>

<style>
	@property --accent {
		syntax: "<color>";
		inherits: true;
		initial-value: #d4302f;
	}

	.hero {
		--hero-pad-x: clamp(1.5rem, 4vw, 55px);
		--hero-transition: 550ms;
		--accent: #d4302f;
		position: relative;
		display: grid;
		grid-template-rows: auto 1fr auto;
		min-height: 100svh;
		overflow: hidden;
		background: #050505;
		color: #fff;
		transition: --accent var(--hero-transition) var(--ease-standard);
	}

	.hero__bg {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.hero__slide {
		position: absolute;
		inset: 0;
		opacity: 0;
		transform: scale(1.045);
		background: var(--slide-image) var(--slide-position, center) / cover no-repeat;
		transition:
			opacity calc(var(--hero-transition) * 1.4) var(--ease-standard),
			transform calc(var(--hero-transition) * 1.4) var(--ease-standard);
	}

	.hero__slide[data-active="true"] {
		opacity: 1;
		transform: scale(1);
	}

	.hero__edge-top {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 160px;
		z-index: 1;
		background: linear-gradient(to bottom, rgba(0, 0, 0, 0.75) 0%, rgba(0, 0, 0, 0.35) 45%, rgba(0, 0, 0, 0) 100%);
		pointer-events: none;
	}

	.hero__edge-bottom {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		height: 250px;
		z-index: 1;
		background: linear-gradient(to top, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0.6) 45%, rgba(0, 0, 0, 0) 100%);
		pointer-events: none;
	}

	.hero__edge-left {
		display: none;
		position: absolute;
		top: 0;
		bottom: 0;
		left: 0;
		width: 45%;
		z-index: 1;
		background: linear-gradient(to right, rgba(0, 0, 0, 0.85) 0%, rgba(0, 0, 0, 0.4) 45%, rgba(0, 0, 0, 0) 100%);
		pointer-events: none;
	}

	@media (min-width: 1025px) {
		.hero__edge-left {
			display: block;
		}
	}

	.hero__nav {
		position: relative;
		z-index: 5;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		padding: var(--space-4) var(--hero-pad-x) 0;
	}

	.hero__logo {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.35rem;
		text-decoration: none;
	}

	.hero__logo-word {
		display: block;
		width: 6.5rem;
		height: auto;
	}

	.hero__logo-sub {
		display: grid;
		justify-items: center;
		width: 6.5rem;
	}

	.hero__logo-sub-img {
		--logo-scale: 1;
		--logo-shift-x: 0%;
		grid-area: 1 / 1;
		align-self: start;
		justify-self: center;
		transform-origin: top center;
		width: 100%;
		height: auto;
		opacity: 0;
		transform: translate(var(--logo-shift-x), -3px) scale(var(--logo-scale));
		transition:
			opacity 400ms var(--ease-standard),
			transform 400ms var(--ease-standard);
	}

	.hero__logo-sub-img[data-logo-img="furniture"] {
		--logo-scale: 1;
	}

	/* Compensate for uneven right-padding baked into these SVG exports —
	   ink is flush to the left edge but doesn't reach the right edge,
	   so it renders slightly left of true center. Measured from path
	   bounding boxes, shift = half the missing right-padding. */
	.hero__logo-sub-img[data-logo-img="design-build"] {
		--logo-scale: 1.02;
		--logo-shift-x: 0.39%;
	}

	.hero__logo-sub-img[data-logo-img="joinery"] {
		--logo-scale: 1.02;
		--logo-shift-x: 0.33%;
	}

	.hero__logo-sub-img[data-logo-img="plants"] {
		--logo-scale: 1.02;
		--logo-shift-x: 0.2%;
	}

	.hero__logo-sub-img[data-logo-img="signage"] {
		--logo-scale: 1.02;
		--logo-shift-x: 0.35%;
	}

	.hero__logo-sub-img[data-active="true"] {
		opacity: 1;
		transform: translate(var(--logo-shift-x), 0) scale(var(--logo-scale));
		transition-delay: 400ms;
	}

	.hero__nav-links {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		flex: 1;
		gap: var(--space-4);
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.hero__nav-group {
		display: flex;
		align-items: center;
		gap: var(--space-4);
	}

	.hero__nav-group--left {
		justify-content: flex-end;
	}

	.hero__nav-group--right {
		justify-content: flex-start;
	}

	.hero__nav-links a {
		text-decoration: none;
		color: rgba(255, 255, 255, 0.8);
		transition: color var(--hero-transition) var(--ease-standard);
	}

	.hero__nav-links a:hover {
		color: var(--accent);
	}

	.hero__dropdown {
		position: relative;
		justify-self: center;
	}

	.hero__dropdown-trigger {
		all: unset;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		cursor: pointer;
		font: inherit;
		color: rgba(255, 255, 255, 0.8);
		transition: color var(--hero-transition) var(--ease-standard);
	}

	.hero__dropdown-trigger:hover,
	.hero__dropdown[data-open="true"] .hero__dropdown-trigger {
		color: var(--accent);
	}

	.hero__dropdown-caret {
		width: 7px;
		height: 7px;
		border-right: 1.5px solid currentColor;
		border-bottom: 1.5px solid currentColor;
		transform: rotate(45deg) translateY(-2px);
		transition: transform 250ms var(--ease-standard);
	}

	.hero__dropdown[data-open="true"] .hero__dropdown-caret {
		transform: rotate(-135deg) translateY(-1px);
	}

	.hero__dropdown-panel {
		position: absolute;
		top: calc(100% + 1.1rem);
		left: 50%;
		transform: translate(-50%, 8px);
		display: flex;
		flex-direction: column;
		min-width: 12rem;
		padding: 0.6rem 0;
		background: #0a0a0a;
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: var(--radius-sm);
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transition:
			opacity 200ms var(--ease-standard),
			transform 200ms var(--ease-standard),
			visibility 200ms;
	}

	.hero__dropdown[data-open="true"] .hero__dropdown-panel {
		opacity: 1;
		visibility: visible;
		transform: translate(-50%, 0);
		pointer-events: auto;
	}

	.hero__dropdown-item {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.65rem 1.1rem;
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		text-decoration: none;
		color: rgba(255, 255, 255, 0.8);
		transition: color 200ms var(--ease-standard);
	}

	.hero__dropdown-item:hover,
	.hero__dropdown-item:focus-visible {
		color: var(--item-accent);
	}

	.hero__dropdown-swatch {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--item-accent);
		flex: none;
	}

	.hero__cta-nav {
		--btn-pad: 0.7rem 1.3rem;
	}

	.hero__content {
		position: relative;
		z-index: 2;
		box-sizing: border-box;
		display: flex;
		align-items: center;
		max-width: 1440px;
		margin: 0;
		padding: var(--space-4) var(--hero-pad-x);
	}

	.hero__copy {
		max-width: 40rem;
		transition:
			opacity 600ms var(--ease-standard),
			transform 600ms var(--ease-standard);
	}

	.hero__copy.is-changing {
		opacity: 0;
		transform: translateY(10px);
		transition:
			opacity 400ms var(--ease-standard),
			transform 400ms var(--ease-standard);
	}

	.hero__copy-text {
		filter: drop-shadow(0 7px 24px rgba(0, 0, 0, 0.54));
	}

	.hero__eyebrow {
		position: relative;
		display: inline-block;
		width: fit-content;
		font-size: calc(var(--text-xs) * 0.85);
		font-weight: 700;
		letter-spacing: 0.207em;
		text-transform: uppercase;
		color: #fff;
		margin-bottom: 1.4rem;
	}

	.hero__eyebrow:hover :global(.pencil-underline) {
		background: currentColor;
	}

	.hero__title {
		font-family: var(--font-display);
		font-size: clamp(1.816875rem, 4.0375vw, calc(var(--text-3xl) * 0.8075));
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: -0.0085em;
		line-height: 1.05;
		margin-bottom: 1.33rem;
	}

	.hero__body {
		font-size: calc(var(--text-lg) * 0.85);
		color: rgba(255, 255, 255, 0.78);
		max-width: 32rem;
		margin-bottom: 1.6rem;
		filter: drop-shadow(0 7px 24px rgba(0, 0, 0, 0.7));
	}

	.hero__button {
		--btn-pad: 0.75rem 1.5rem;
		position: relative;
		display: inline-flex;
		background: #fff;
		color: #050505;
		text-decoration: none;
		overflow: hidden;
		isolation: isolate;
	}

	.hero__button-bg {
		position: absolute;
		inset: 0;
		width: 2px;
		background: var(--accent);
		transition: width 350ms var(--ease-standard);
		z-index: 0;
	}

	.hero__button:hover .hero__button-bg,
	.hero__button:focus-visible .hero__button-bg {
		width: 100%;
	}

	.hero__button:active .hero__button-bg {
		background: color-mix(in srgb, var(--accent) 80%, black);
	}

	.hero__button-edge {
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 2px;
		background: #fff;
		opacity: 0;
		z-index: 1;
		transition: opacity 350ms var(--ease-standard);
	}

	.hero__button:hover .hero__button-edge,
	.hero__button:focus-visible .hero__button-edge {
		opacity: 1;
	}

	.hero__button-label {
		position: relative;
		z-index: 1;
		display: inline-flex;
		align-items: center;
		font-size: var(--text-xs);
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		padding: var(--btn-pad);
		white-space: nowrap;
		transition: transform 150ms var(--ease-standard);
	}

	.hero__button-label::after {
		content: attr(data-label);
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		padding: var(--btn-pad);
		color: #fff;
		clip-path: inset(0 100% 0 0);
		transition: clip-path 350ms var(--ease-standard);
		pointer-events: none;
	}

	.hero__button:hover .hero__button-label::after,
	.hero__button:focus-visible .hero__button-label::after {
		clip-path: inset(0 0 0 0);
	}

	.hero__button:active .hero__button-label {
		transform: scale(0.97);
	}

	.hero__footer {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		gap: calc(var(--space-4) + 25px);
		padding: 0 var(--hero-pad-x) calc(var(--space-4) + 10px);
	}

	.hero__divisions {
		position: relative;
		padding-top: 0;
	}

	.hero__divisions-track {
		position: relative;
		isolation: isolate;
	}

	.hero__divisions-line {
		display: block;
		width: 100%;
		height: 1px;
		background: rgba(255, 255, 255, 0.7);
	}

	.hero__indicator {
		position: absolute;
		top: 0;
