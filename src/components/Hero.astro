</style>

<script>
	interface Division {
		id: string;
		accent: string;
		image: string;
		logoSub: string;
		eyebrow: string;
		title: string;
		body: string;
		cta: string;
		href: string;
	}

	const hero = document.getElementById("hero") as HTMLElement;
	const divisions: Division[] = JSON.parse(hero.dataset.divisionsJson ?? "[]");

	const slides = Array.from(hero.querySelectorAll<HTMLElement>("[data-slide]"));
	const logoImgs = Array.from(hero.querySelectorAll<HTMLElement>("[data-logo-img]"));
	const links = Array.from(hero.querySelectorAll<HTMLButtonElement>("[data-division]"));
	const indicator = hero.querySelector<HTMLElement>("[data-indicator]");
	const divisionsWrap = hero.querySelector<HTMLElement>("[data-divisions]");
	const copy = hero.querySelector<HTMLElement>("[data-copy]");

	const eyebrowEl = hero.querySelector<HTMLElement>('[data-field="eyebrow"]');
	const titleEl = hero.querySelector<HTMLElement>('[data-field="title"]');
	const bodyEl = hero.querySelector<HTMLElement>('[data-field="body"]');
	const ctaEl = hero.querySelector<HTMLAnchorElement>('[data-field="cta"]');
	const ctaLabelEl = hero.querySelector<HTMLElement>('[data-field="cta-label"]');
	const underlineEl = hero.querySelector<HTMLElement>(".pencil-underline");
	const mobileIndicator = hero.querySelector<HTMLElement>("[data-mobile-indicator]");
	const mobileLabelEl = hero.querySelector<HTMLElement>('[data-field="mobile-label"]');
	const mobileArrowEl = hero.querySelector<HTMLAnchorElement>('[data-field="mobile-arrow"]');

	function replayUnderline() {
		if (!underlineEl) return;
		underlineEl.classList.remove("is-visible");
		// force reflow so the removal is committed before re-adding the class
		void underlineEl.offsetWidth;
		underlineEl.classList.add("is-visible");
	}

	const logoDelayMs = 200;
	const copyExitMs = 400;
	const stepMoveMs = 128;
	const minMoveMs = 176;
	const maxMoveMs = 720;
	let changeTimer: number | undefined;
	let logoTimer: number | undefined;
	let lastMoveMs = minMoveMs;

	function positionIndicator(link: HTMLButtonElement, durationMs: number) {
		if (!indicator) return;
		const li = link.closest("li") as HTMLElement;
		indicator.style.transitionDuration = `${durationMs}ms`;
		indicator.style.left = `${li.offsetLeft}px`;
		indicator.style.width = `${li.offsetWidth}px`;
	}

	// longer hops (e.g. Design & Build -> Signage) get a proportionally longer,
	// more visible slide instead of covering more ground in the same fixed time
	function setActive(id: string, instant = false) {
		if (hero.dataset.active === id) return;

		const index = divisions.findIndex((d) => d.id === id);
		const division = divisions[index];
		const link = links[index];
		const slide = slides[index];
		if (!division || !link || !slide) return;

		const previousIndex = divisions.findIndex((d) => d.id === hero.dataset.active);
		const steps = previousIndex >= 0 ? Math.max(1, Math.abs(index - previousIndex)) : 1;
		lastMoveMs = instant ? 0 : Math.min(maxMoveMs, Math.max(minMoveMs, stepMoveMs * steps));

		hero.dataset.active = id;
		hero.style.setProperty("--accent", division.accent);

		slides.forEach((s) => (s.dataset.active = s === slide ? "true" : "false"));
		links.forEach((l) => l.setAttribute("aria-current", l === link ? "true" : "false"));
		positionIndicator(link, lastMoveMs);

		window.clearTimeout(logoTimer);
		const logoDelay = instant ? 0 : logoDelayMs;
		logoTimer = window.setTimeout(() => {
			logoImgs.forEach((img) => (img.dataset.active = img.dataset.logoImg === id ? "true" : "false"));
		}, logoDelay);

		window.clearTimeout(changeTimer);
		if (!instant) {
			copy?.classList.add("is-changing");
			mobileIndicator?.classList.add("is-changing");
		}
		const copyDelay = instant ? 0 : copyExitMs;
		changeTimer = window.setTimeout(() => {
			if (eyebrowEl) eyebrowEl.textContent = division.eyebrow;
			if (titleEl) titleEl.textContent = division.title;
			if (bodyEl) bodyEl.textContent = division.body;
			if (ctaLabelEl) {
				ctaLabelEl.textContent = division.cta;
				ctaLabelEl.setAttribute("data-label", division.cta);
			}
			if (ctaEl) ctaEl.setAttribute("href", division.href);
			if (mobileLabelEl) mobileLabelEl.textContent = division.eyebrow.replace("HOX BOX ", "");
			syncMobileLineWidth();
			if (mobileArrowEl) {
				mobileArrowEl.setAttribute("href", division.href);
				mobileArrowEl.setAttribute("aria-label", `Go to ${division.eyebrow}`);
			}
			copy?.classList.remove("is-changing");
			mobileIndicator?.classList.remove("is-changing");
			replayUnderline();
		}, copyDelay);
	}

	const previewDelayMs = 500;
	const riseMs = 384;
	const fadeOutMs = 280;
	const snapMs = 160;
	const arrowFadeMs = 200;
	const baseFill = 0.16;
	let previewTimer: number | undefined;
	let riseStartTimer: number | undefined;
	let lockTimer: number | undefined;
	let pinnedId: string = divisions[0]?.id ?? "";
	const items = Array.from(hero.querySelectorAll<HTMLLIElement>("[data-item]"));

	function getItem(id: string) {
		return items.find((item) => item.dataset.item === id);
	}

	function getInner(id: string) {
		return getItem(id)?.querySelector<HTMLElement>(".hero__division-inner");
	}

	function setFill(item: HTMLLIElement | undefined, value: number, durationMs: number) {
		if (!item) return;
		item.style.setProperty("--fill", String(value));
		item.style.setProperty("--fill-duration", `${durationMs}ms`);
	}

	function setArrowFill(id: string, value: number, durationMs: number = arrowFadeMs) {
		const item = getItem(id);
		if (item) {
			item.style.setProperty("--arrow-fill", String(value));
			item.style.setProperty("--arrow-duration", `${durationMs}ms`);
		}
	}

	function clearTimers() {
		window.clearTimeout(previewTimer);
		window.clearTimeout(riseStartTimer);
		window.clearTimeout(lockTimer);
	}

	// the low-opacity box travels with the indicator immediately (same duration),
	// then — only if the hover is sustained — rises the rest of the way to full/lock
	function switchTo(id: string) {
		const previousId = hero.dataset.active ?? pinnedId;
		setActive(id);
		const moveMs = lastMoveMs;
		setFill(getItem(id), baseFill, moveMs);
		setArrowFill(id, 0, 0);
		if (previousId !== id) {
			setFill(getItem(previousId), 0, fadeOutMs);
			setArrowFill(previousId, 0, arrowFadeMs);
		}

		riseStartTimer = window.setTimeout(() => {
			setFill(getItem(id), 1, riseMs);
		}, moveMs);
		lockTimer = window.setTimeout(() => lockTo(id), moveMs + riseMs);
	}

	function lockTo(id: string, riseDurationMs: number = snapMs) {
		const previousId = pinnedId;
		pinnedId = id;
		items.forEach((item) => item.setAttribute("data-pinned", item.dataset.item === id ? "true" : "false"));
		setFill(getItem(id), 1, riseDurationMs);
		if (previousId !== id) {
			setFill(getItem(previousId), 0, fadeOutMs);
			getInner(previousId)?.classList.remove("is-grown");
		}
		setActive(id);

		setArrowFill(previousId, 0, arrowFadeMs);
		setArrowFill(id, 1, arrowFadeMs);
	}

	// whenever the hero has scrolled fully off-screen and the visitor scrolls back
	// up to it, snap straight back to the default (Design & Build) tab
	const defaultDivisionId = divisions[0]?.id ?? "";
	let heroWasOffscreen = false;

	function resetToDefaultDivision() {
		if (pinnedId === defaultDivisionId && hero.dataset.active === defaultDivisionId) return;
		clearTimers();
		const previousId = pinnedId;
		pinnedId = defaultDivisionId;
		items.forEach((item) => item.setAttribute("data-pinned", item.dataset.item === defaultDivisionId ? "true" : "false"));
		setFill(getItem(defaultDivisionId), 1, 0);
		setFill(getItem(previousId), 0, 0);
		getInner(previousId)?.classList.remove("is-grown");
		setArrowFill(previousId, 0, 0);
		setArrowFill(defaultDivisionId, 1, 0);
		setActive(defaultDivisionId, true);
	}

	let scrollCheckQueued = false;
	function checkHeroVisibility() {
		scrollCheckQueued = false;
		const isOffscreen = hero.getBoundingClientRect().bottom <= 0;
		if (isOffscreen) {
			heroWasOffscreen = true;
		} else if (heroWasOffscreen) {
			resetToDefaultDivision();
			heroWasOffscreen = false;
		}
	}
	window.addEventListener(
		"scroll",
		() => {
			if (scrollCheckQueued) return;
			scrollCheckQueued = true;
			requestAnimationFrame(checkHeroVisibility);
		},
		{ passive: true }
	);

	links.forEach((link) => {
		const id = link.dataset.division as string;
		const hoverZone = link.closest("li") as HTMLElement;

		hoverZone.addEventListener("mouseenter", () => {
			clearTimers();

			if (id === pinnedId) {
				const strandedId = hero.dataset.active;
				setActive(id);
				// smooth, same pace as the normal rise — not an instant snap
				setFill(getItem(id), 1, riseMs);
				setArrowFill(id, 1, riseMs);
				// a different item may have been mid-preview (already risen) when we
				// jumped back here before it locked in — fade it back out, don't leave it stuck
				if (strandedId && strandedId !== id) {
					setFill(getItem(strandedId), 0, fadeOutMs);
					setArrowFill(strandedId, 0, arrowFadeMs);
				}
				// only grow when re-hovering an item that's already active/locked —
				// not during the initial hover that's still activating it
				getInner(id)?.classList.add("is-grown");
				return;
			}

			previewTimer = window.setTimeout(() => switchTo(id), previewDelayMs);
		});

		hoverZone.addEventListener("mouseleave", () => {
			clearTimers();
			getInner(id)?.classList.remove("is-grown");

			if (id === pinnedId) return;

			// hovering off no longer reverts to the previously pinned division — if the
			// preview had already taken over as active, lock it in right where it is
			if (hero.dataset.active === id) {
				lockTo(id, snapMs);
			}
		});

		link.addEventListener("focus", () => {
			clearTimers();
			switchTo(id);
		});

		link.addEventListener("click", () => {
			clearTimers();
			lockTo(id, snapMs);
		});
	});

	divisionsWrap?.addEventListener("mouseleave", () => {
		clearTimers();
		items.forEach((item) => item.querySelector(".hero__division-inner")?.classList.remove("is-grown"));

		// leaving the row no longer reverts to the previously pinned division — whatever
		// was active when the pointer left gets locked in, same as leaving a single item
		const activeId = hero.dataset.active ?? pinnedId;
		if (activeId !== pinnedId) {
			lockTo(activeId, snapMs);
			return;
		}
		items.forEach((item) => {
			const isPinned = item.dataset.item === pinnedId;
			setFill(item, isPinned ? 1 : 0, fadeOutMs);
			if (item.dataset.item) setArrowFill(item.dataset.item, isPinned ? 1 : 0, arrowFadeMs);
		});
	});

	window.addEventListener("resize", () => {
		const active = links.find((l) => l.getAttribute("aria-current") === "true") ?? links[0];
		if (active) positionIndicator(active, 0);
	});

	if (links[0]) {
		requestAnimationFrame(() => positionIndicator(links[0], 0));
	}

	copy?.classList.add("is-changing");
	requestAnimationFrame(() => {
		requestAnimationFrame(() => copy?.classList.remove("is-changing"));
	});

	// keep a fixed gap between each label and its arrow (as one centered group),
	// regardless of how wide the division name itself is
	const labelArrowGapPx = 10;

	function layoutLabelArrowGaps() {
		items.forEach((item) => {
			const label = item.querySelector<HTMLElement>(".hero__division-label");
			const arrow = item.querySelector<HTMLElement>(".hero__division-arrow");
			if (!label || !arrow) return;

			const labelWidth = label.getBoundingClientRect().width;
			const arrowWidth = arrow.getBoundingClientRect().width || 20;

			item.style.setProperty("--label-shift", `${-(labelArrowGapPx + arrowWidth) / 2}px`);
			item.style.setProperty("--arrow-x", `${(labelWidth + labelArrowGapPx) / 2}px`);
		});
	}

	layoutLabelArrowGaps();
	window.addEventListener("resize", layoutLabelArrowGaps);
	document.fonts?.ready.then(layoutLabelArrowGaps).catch(() => {});

	// mobile accent line should match the width of the current division's
	// label + gap + arrow as a group, not just the label text alone
	const mobileLineEl = hero.querySelector<HTMLElement>(".hero__mobile-indicator-line");
	const mobileIndicatorRowEl = hero.querySelector<HTMLElement>(".hero__mobile-indicator-row");

	function syncMobileLineWidth() {
		if (!mobileIndicatorRowEl || !mobileLineEl) return;
		mobileLineEl.style.setProperty("--mobile-line-width", `${mobileIndicatorRowEl.getBoundingClientRect().width}px`);
	}

	syncMobileLineWidth();
	window.addEventListener("resize", syncMobileLineWidth);
	document.fonts?.ready.then(syncMobileLineWidth).catch(() => {});

	const dropdown = hero.querySelector<HTMLElement>("[data-dropdown]");
	const dropdownTrigger = hero.querySelector<HTMLButtonElement>("[data-dropdown-trigger]");

	function closeDropdown() {
		if (!dropdown) return;
		dropdown.dataset.open = "false";
		dropdownTrigger?.setAttribute("aria-expanded", "false");
	}

	function toggleDropdown() {
		if (!dropdown) return;
		const isOpen = dropdown.dataset.open === "true";
		dropdown.dataset.open = String(!isOpen);
		dropdownTrigger?.setAttribute("aria-expanded", String(!isOpen));
	}

	dropdownTrigger?.addEventListener("click", (event) => {
		event.stopPropagation();
		toggleDropdown();
	});

	document.addEventListener("click", (event) => {
		if (dropdown && !dropdown.contains(event.target as Node)) closeDropdown();
	});

	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape") closeDropdown();
	});

	const burgerTrigger = hero.querySelector<HTMLButtonElement>("[data-burger-trigger]");
	const mobilePanel = hero.querySelector<HTMLElement>("[data-mobile-panel]");

	function closeMobilePanel() {
		if (!mobilePanel) return;
		mobilePanel.dataset.open = "false";
		burgerTrigger?.setAttribute("aria-expanded", "false");
	}

	function toggleMobilePanel() {
		if (!mobilePanel) return;
		const isOpen = mobilePanel.dataset.open === "true";
		mobilePanel.dataset.open = String(!isOpen);
		burgerTrigger?.setAttribute("aria-expanded", String(!isOpen));
	}

	burgerTrigger?.addEventListener("click", (event) => {
		event.stopPropagation();
		toggleMobilePanel();
	});

	mobilePanel?.addEventListener("click", (event) => {
		if ((event.target as HTMLElement).tagName === "A") closeMobilePanel();
	});

	window.addEventListener("resize", () => {
		if (window.innerWidth > 1024) closeMobilePanel();
	});

	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape") closeMobilePanel();
	});

	// On phone breakpoints the division tabs collapse to a single label + arrow,
	// so autoplay through them every 5s instead of relying on hover to switch.
	const mobileMediaQuery = window.matchMedia("(max-width: 640px)");
	const autoplayIntervalMs = 5000;
	let autoplayTimer: number | undefined;

	function stopAutoplay() {
		window.clearInterval(autoplayTimer);
		autoplayTimer = undefined;
	}

	function startAutoplay() {
		stopAutoplay();
		autoplayTimer = window.setInterval(() => {
			const currentIndex = divisions.findIndex((d) => d.id === (hero.dataset.active ?? pinnedId));
			const next = divisions[(currentIndex + 1) % divisions.length];
			if (next) lockTo(next.id, snapMs);
		}, autoplayIntervalMs);
	}

	function syncAutoplay() {
		if (mobileMediaQuery.matches) {
			startAutoplay();
		} else {
			stopAutoplay();
		}
	}

	mobileMediaQuery.addEventListener("change", syncAutoplay);
	syncAutoplay();
</script>
