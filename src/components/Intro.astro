---
import PencilUnderline from "./PencilUnderline.astro";
---

<section class="intro" id="intro" style="--accent:#d4302f">
	<div class="intro__inner">
		<div class="intro__media" data-collage>
			<div class="intro__img intro__img--portrait-a" data-parallax data-speed="1" data-dir="down">
				<img
					src="/images/Design & Build/Design & Build_85.webp"
					alt="A Hox Box furnished interior"
					loading="lazy"
				/>
			</div>
			<div class="intro__img intro__img--portrait-b" data-parallax data-speed="0.85" data-dir="up">
				<img
					src="/images/Design & Build/Design & Build_185.webp"
					alt="A Hox Box breakout space with joinery planters and seating"
					loading="lazy"
				/>
			</div>
		</div>

		<div class="intro__copy">
			<p class="intro__eyebrow">
				<span>ABOUT HOX BOX</span><PencilUnderline color="var(--accent)" thickness={2} />
			</p>
			<h2 class="intro__title">
				Over 30 years of design, build and everything in between
			</h2>
			<p class="intro__body">
				Hox Box has been designing and building spaces for over three decades. Design & Build,
				Furniture, Joinery, Plants and Signage aren't five separate suppliers stitched together;
				they're one in-house team working in tandem, covering every stage from pre-construction
				and budget management through to design, build, fit-out and handover.
			</p>
			<p class="intro__body intro__body--secondary">
				One point of contact, one accountable team, no gaps for things to fall through, delivered
				faster and with far less friction than the traditional multi-contractor route.
			</p>
			<a class="intro__button intro__button--dark" href="/about">
				<span class="intro__button-bg" aria-hidden="true"></span>
				<span class="intro__button-edge" aria-hidden="true"></span>
				<span class="intro__button-label" data-label="About us">About us</span>
			</a>
		</div>
	</div>
</section>

<style>
	.intro {
		--btn-pad: 0.75rem 1.5rem;
		position: relative;
		min-height: 100svh;
		background: var(--color-bg-light);
		color: var(--color-text);
	}

	.intro__inner {
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: stretch;
		min-height: 100svh;
		max-width: 1440px;
		margin: 0 auto;
	}

	.intro__media {
		position: relative;
		overflow: hidden;
		padding: clamp(24px, 3vw, 40px) clamp(8px, 1.2vw, 16px) clamp(24px, 3vw, 40px) clamp(56px, 7vw, 96px);
		box-sizing: border-box;
		background: var(--color-bg-light);
	}

	.intro__img {
		position: absolute;
		overflow: hidden;
		box-shadow: 0 24px 48px -16px rgba(20, 16, 8, 0.35);
		transform: translate3d(var(--dx, 0px), var(--dy, 0px), 0);
		will-change: transform;
	}

	.intro__img img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: saturate(1.15);
	}

	.intro__img--portrait-a,
	.intro__img--portrait-b {
		width: 47.5%;
		height: 71.3%;
	}

	.intro__img--portrait-a {
		left: 8%;
		bottom: 5%;
		z-index: 2;
	}

	.intro__img--portrait-b {
		left: 44%;
		top: 15%;
		z-index: 4;
	}

	@media (max-width: 1180px) {
		.intro__img--portrait-a,
		.intro__img--portrait-b {
			width: 53.5%;
			height: 61.4%;
		}

		.intro__img--portrait-a {
			left: 4%;
			bottom: 10.3%;
		}

		.intro__img--portrait-b {
			left: 40%;
			top: 20.6%;
		}
	}

	.intro__copy {
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: var(--section-pad-y) clamp(2rem, 4.5vw, 4rem) var(--section-pad-y) clamp(0.75rem, 1.5vw, 1.25rem);
	}

	.intro__eyebrow {
		position: relative;
		display: inline-block;
		width: fit-content;
		font-size: calc(var(--text-xs) * 0.85);
		font-weight: 700;
		letter-spacing: 0.207em;
		text-transform: uppercase;
		color: var(--color-text);
		margin-bottom: 1.6rem;
	}

	.intro__eyebrow:hover :global(.pencil-underline) {
		background: currentColor;
	}

	.intro__title {
		font-family: var(--font-display);
		font-size: clamp(1.9rem, 3.2vw, var(--text-3xl));
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: -0.0085em;
		line-height: 1.12;
		margin: 0 0 1.6rem;
		max-width: 28ch;
	}

.intro__body {
		font-size: calc(var(--text-lg) * 0.85);
		color: var(--color-text-muted);
		max-width: 38rem;
		margin: 0 0 1.2rem;
	}

	.intro__button {
		--btn-pad: 0.75rem 1.5rem;
		position: relative;
		display: inline-flex;
		width: fit-content;
		margin-top: 0.8rem;
		background: #fff;
		color: #050505;
		text-decoration: none;
		overflow: hidden;
		isolation: isolate;
	}

	.intro__button-bg {
		position: absolute;
		inset: 0;
		width: 2px;
		background: var(--accent);
		transition: width 350ms var(--ease-standard);
		z-index: 0;
	}

	.intro__button:hover .intro__button-bg,
	.intro__button:focus-visible .intro__button-bg {
		width: 100%;
	}

	.intro__button:active .intro__button-bg {
		background: color-mix(in srgb, var(--accent) 80%, black);
	}

	.intro__button-edge {
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 2px;
		background: #fff;
		opacity: 0;
		z-index: 1;
		transition: opacity 350ms var(--ease-standard);
	}

	.intro__button:hover .intro__button-edge,
	.intro__button:focus-visible .intro__button-edge {
		opacity: 1;
	}

	.intro__button-label {
		position: relative;
		z-index: 1;
		display: inline-flex;
		align-items: center;
		font-size: var(--text-xs);
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		padding: var(--btn-pad);
		white-space: nowrap;
		transition: transform 150ms var(--ease-standard);
	}

	.intro__button-label::after {
		content: attr(data-label);
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		padding: var(--btn-pad);
		color: #fff;
		clip-path: inset(0 100% 0 0);
		transition: clip-path 350ms var(--ease-standard);
		pointer-events: none;
	}

	.intro__button:hover .intro__button-label::after,
	.intro__button:focus-visible .intro__button-label::after {
		clip-path: inset(0 0 0 0);
	}

	.intro__button:active .intro__button-label {
		transform: scale(0.97);
	}

	/* Dark variant: graphite fill, white text, red accent edge on the left. */
	.intro__button--dark {
		background: var(--color-graphite);
		color: #fff;
	}

	.intro__button--dark .intro__button-bg {
		background: var(--accent);
	}

	.intro__button--dark:active .intro__button-bg {
		background: color-mix(in srgb, var(--accent) 80%, black);
	}

	.intro__button--dark .intro__button-edge {
		background: var(--color-graphite);
		opacity: 0;
	}

	.intro__button--dark:hover .intro__button-edge,
	.intro__button--dark:focus-visible .intro__button-edge {
		opacity: 1;
	}

	@media (max-width: 1024px) {
		.intro {
			min-height: auto;
		}

		.intro__inner {
			grid-template-columns: 1fr;
			min-height: auto;
		}

		.intro__media {
			height: 60vh;
			padding: 20px;
		}

		.intro__img--portrait-a,
		.intro__img--portrait-b {
			width: 58%;
			height: 72%;
		}

		.intro__img--portrait-a {
			left: 2%;
			bottom: 2%;
		}

		.intro__img--portrait-b {
			left: 30%;
			top: 2%;
		}

		.intro__copy {
			padding: var(--space-6) var(--space-4);
		}
	}

	@media (max-width: 640px) {
		.intro__inner {
			display: flex;
			flex-direction: column;
		}

		.intro__copy {
			order: 1;
			align-items: center;
			text-align: center;
			padding: var(--space-6) var(--space-4) var(--space-4);
		}

		.intro__media {
			order: 2;
			position: relative;
			height: auto;
			aspect-ratio: 4 / 3.9;
			padding: var(--space-5) var(--space-4) var(--space-6);
			display: block;
		}

		.intro__img,
		.intro__img--portrait-a,
		.intro__img--portrait-b {
			position: absolute;
			inset: var(--space-5) var(--space-4) var(--space-6);
			width: auto;
			height: auto;
			left: var(--space-4);
			right: var(--space-4);
			top: var(--space-5);
			bottom: var(--space-6);
			border-radius: 4px;
			transform: none !important;
			opacity: 1;
			transition: opacity 900ms var(--ease-standard, ease);
		}

		.intro__img--portrait-a {
			z-index: 2;
		}

		.intro__img--portrait-b {
			z-index: 3;
			display: block;
			opacity: 0;
		}

		.intro__media.is-flipped .intro__img--portrait-a {
			opacity: 0;
		}

		.intro__media.is-flipped .intro__img--portrait-b {
			opacity: 1;
		}

		.intro__eyebrow {
			font-size: calc(var(--text-xs) * 0.7);
			margin-bottom: 1rem;
		}

		.intro__title {
			font-size: 1.5rem;
			line-height: 1.15;
			margin-bottom: 1rem;
			max-width: 22ch;
		}

		.intro__body {
			font-size: calc(var(--text-lg) * 0.6);
			line-height: 1.45;
			max-width: 32rem;
		}

		.intro__body--secondary {
			display: none;
		}

		.intro__button {
			margin-top: 0.4rem;
			margin-left: auto;
			margin-right: auto;
		}
	}
</style>

<script>
	const media = document.querySelector<HTMLElement>("[data-collage]");
	const parallaxEls = Array.from(document.querySelectorAll<HTMLElement>("[data-parallax]"));

	if (
		media &&
		parallaxEls.length &&
		!window.matchMedia("(prefers-reduced-motion: reduce)").matches &&
		!window.matchMedia("(max-width: 640px)").matches
	) {
		// px of travel from one edge of the scroll range to the other, per image
		const ranges: Record<string, number> = { up: 90, down: 130, side: 100 };

		let ticking = false;
		function update() {
			ticking = false;
			const rect = media!.getBoundingClientRect();
			const viewportH = window.innerHeight;
			// -1 when the section's centre is at the bottom of the viewport, +1 at the top
			const progress = Math.max(
				-1,
				Math.min(1, (viewportH / 2 - (rect.top + rect.height / 2)) / (viewportH / 2 + rect.height / 2))
			);

			for (const el of parallaxEls) {
				const speed = parseFloat(el.dataset.speed ?? "1");
				const dir = el.dataset.dir ?? "up";
				const range = ranges[dir] ?? 100;
				const offset = progress * range * speed;

				if (dir === "side") {
					el.style.setProperty("--dx", `${offset}px`);
					el.style.setProperty("--dy", "0px");
				} else {
					const sign = dir === "down" ? -1 : 1;
					el.style.setProperty("--dy", `${offset * sign}px`);
					el.style.setProperty("--dx", "0px");
				}
			}
		}

		function onScroll() {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(update);
		}

		window.addEventListener("scroll", onScroll, { passive: true });
		window.addEventListener("resize", onScroll);
		update();
	}

	if (media && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
		const mobileQuery = window.matchMedia("(max-width: 640px)");

		if (mobileQuery.matches) {
			let flipTicking = false;
			function updateFlip() {
				flipTicking = false;
				const rect = media!.getBoundingClientRect();
				// flip partway through the image's scroll past the viewport, while it's still visible
				const flipped = rect.top < window.innerHeight * 0.35 && rect.bottom > 0;
				media!.classList.toggle("is-flipped", flipped);
			}
			function onFlipScroll() {
				if (flipTicking) return;
				flipTicking = true;
				requestAnimationFrame(updateFlip);
			}
			window.addEventListener("scroll", onFlipScroll, { passive: true });
			window.addEventListener("resize", onFlipScroll);
			updateFlip();
		}
	}
</script>
