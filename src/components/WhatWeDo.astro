---
import PencilUnderline from "./PencilUnderline.astro";

// "What We Do" stacked-card sequence, 7 cards.
// "Small Works" removed: it isn't part of the confirmed services list in
// docs/brand/copywriting.md, so it shouldn't have been on this site at all.
// Order otherwise matches the site's original card order (Office Design,
// Office Fit-Out, Office Refurbishment, Pre-Construction Planning, Interior
// Design, 3D Visualisation, Aftercare), just renumbered after the removal.
// See docs/brand/what-we-do-pages.md for prior copy source,
// docs/brand/copywriting.md for voice rules (no em dashes, UK spelling).
// Cards alternate image side (odd = image right, even = image left) and scroll in
// from alternating directions at varying heights as the page scrolls.
const cards = [
	{
		index: "01.",
		name: "Office Design",
		description:
			"We spend time understanding how your team actually works before we draw a single wall. Space planning, interior direction and concept development, done in-house, so the design that gets built is the one that gets used.",
		image: "/images/DESIGN BEFORE.jpg",
		alt: "Office space designed and built by Hox Box",
		slug: "office-design",
		reverse: false,
		enterX: "-120vw",
		enterY: "0vh",
	},
	{
		index: "02.",
		name: "Office Fit-Out",
		description:
			"Turning an approved design into a finished space: construction, MEP coordination, joinery and installation, managed in-house from start to handover. One team carries the project through, so nothing gets lost between contractors.",
		image: "/images/Design & Build/Design & Build_196.jpg",
		alt: "Bespoke retail fit-out delivered by Hox Box",
		slug: "office-fit-out",
		reverse: true,
		enterX: "120vw",
		enterY: "-18vh",
	},
	{
		index: "03.",
		name: "Office Refurbishment",
		description:
			"Upgrading or reconfiguring an existing space, occupied or not, rather than starting again from scratch. Strip-out, new finishes and reinstatement, planned to keep disruption to the people still using the building to a minimum.",
		image: "/images/Design & Build/design & build 197.jpg",
		alt: "Office space mid-refurbishment",
		slug: "office-refurbishment",
		reverse: false,
		enterX: "-120vw",
		enterY: "12vh",
	},
	{
		index: "04.",
		name: "Pre-Construction Planning",
		description:
			"Feasibility studies, budgeting, scheduling and risk assessment, worked through before a single wall comes down. Getting this stage right early is what keeps a project on time and on budget later.",
		image: "/images/Design & Build/Design & Build_26.webp",
		alt: "Groundworks underway on a Hox Box project",
		slug: "pre-construction-planning",
		reverse: true,
		enterX: "120vw",
		enterY: "-12vh",
		compact: true,
	},
	{
		index: "05.",
		name: "Interior Design",
		description:
			"The design-led side of the process: mood, materials, layout and finish, developed around your brand and how your people actually use a space. A distinct discipline from Office Design's planning focus, built to work alongside it.",
		image: "/images/Design & Build/Design & Build_149.webp",
		alt: "Styled bedroom interior scheme by Hox Box",
		slug: "interior-design",
		reverse: false,
		enterX: "-120vw",
		enterY: "6vh",
	},
	{
		index: "06.",
		name: "3D Visualisation",
		description:
			"Photorealistic renders and walkthroughs that show exactly how a scheme will look and feel before a single brick is laid. Decisions get made with confidence, not guesswork, and changes cost nothing at this stage.",
		image: "/images/Design & Build/Design & Build_54.webp",
		alt: "Styled terrace scheme showing the finished vision for a space",
		slug: "3d-visualisation",
		reverse: true,
		enterX: "120vw",
		enterY: "-6vh",
	},
	{
		index: "07.",
		name: "Aftercare",
		description:
			"The relationship does not end at handover. We stay on as your single point of contact for ongoing support, so small issues get sorted quickly and the space keeps working the way it was designed to.",
		image: "/images/Design & Build/Design & Build_164.webp",
		alt: "Completed office space ready for handover",
		slug: "aftercare",
		reverse: false,
		enterX: "-120vw",
		enterY: "0vh",
	},
];
---

<div class="what-we-do__divider" aria-hidden="true"></div>

<section class="what-we-do" id="what-we-do">
	<div class="what-we-do__header">
		<p class="what-we-do__eyebrow">
			<span>This is what we do</span><PencilUnderline color="var(--color-division-design-build)" thickness={2} />
		</p>
		<h2 class="what-we-do__title">One team, every stage</h2>
		<p class="what-we-do__subtitle">
			From first sketch to final handover, design, build and everything either side of it.
		</p>
	</div>

	<div class="what-we-do__track" data-wwd-track style={`height:${cards.length * 160 + 100}vh;`}>
		<div class="what-we-do__stage">
			{
				cards.map((card, i) => (
					<article
						class:list={["wwd-card", { "wwd-card--reverse": card.reverse }]}
						data-wwd-item
						style={`--enter-x:${card.enterX}; --enter-y:${card.enterY}; z-index:${i + 1};`}
					>
						<div class:list={["wwd-card__content", { "wwd-card__content--compact": card.compact }]}>
							<p class="wwd-card__eyebrow">
								<span>{card.index}</span>
								<PencilUnderline color="var(--color-division-design-build)" thickness={2} />
							</p>
							<h3 class="wwd-card__name">{card.name}</h3>
							<p class="wwd-card__description">{card.description}</p>

							<a class="wwd-card__button" href={`/what-we-do/${card.slug}`}>
								<span class="wwd-card__button-bg" aria-hidden="true" />
								<span class="wwd-card__button-edge" aria-hidden="true" />
								<span class="wwd-card__button-label">Learn more</span>
							</a>
						</div>

						<div class="wwd-card__media">
							<img class="wwd-card__media-image" src={card.image} alt={card.alt} loading="lazy" />
						</div>
					</article>
				))
			}

			<div class="wwd-scroll-hint wwd-scroll-hint--left" data-wwd-scroll-hint aria-hidden="true">
				<span class="wwd-scroll-hint__chevron" style="animation-delay:0ms" />
				<span class="wwd-scroll-hint__chevron" style="animation-delay:200ms" />
				<span class="wwd-scroll-hint__chevron" style="animation-delay:400ms" />
			</div>

			<div class="wwd-scroll-hint wwd-scroll-hint--right" data-wwd-scroll-hint aria-hidden="true">
				<span class="wwd-scroll-hint__chevron" style="animation-delay:0ms" />
				<span class="wwd-scroll-hint__chevron" style="animation-delay:200ms" />
				<span class="wwd-scroll-hint__chevron" style="animation-delay:400ms" />
			</div>

			<div class="wwd-progress" aria-hidden="true">
				<div class="wwd-progress__track">
					<div class="wwd-progress__fill" data-wwd-progress-fill />
				</div>
				<span class="wwd-progress__label" data-wwd-progress-label>1/7</span>
			</div>
		</div>
	</div>
</section>

<style>
	.what-we-do__divider {
		height: 1px;
		width: 100%;
		background: linear-gradient(
			to right,
			var(--color-bg-light) 0%,
			color-mix(in srgb, var(--color-graphite) 60%, var(--color-bg-light)) 50%,
			var(--color-bg-light) 100%
		);
	}

	.what-we-do {
		box-sizing: border-box;
		background: var(--color-bg-light);
		color: var(--color-text);
	}

	.what-we-do__header {
		max-width: 40rem;
		margin: 0 auto;
		padding: var(--section-pad-y) var(--space-4) 0.9rem;
		text-align: center;
	}

	.what-we-do__eyebrow {
		position: relative;
		display: inline-block;
		width: fit-content;
		font-size: calc(var(--text-xs) * 0.85);
		font-weight: 700;
		letter-spacing: 0.207em;
		text-transform: uppercase;
		color: var(--color-text);
		margin: 0 0 var(--space-4);
	}

	.what-we-do__title {
		font-family: var(--font-display);
		font-size: clamp(1.9rem, 3.2vw, var(--text-3xl));
		text-transform: uppercase;
		line-height: var(--leading-tight);
		color: var(--color-text);
		margin: 0 0 var(--space-3);
		white-space: nowrap;
	}

	.what-we-do__subtitle {
		font-size: calc(var(--text-lg) * 0.85);
		color: var(--color-text-muted);
		margin: 0;
	}

	.what-we-do__track {
		position: relative;
	}

	.what-we-do__stage {
		position: sticky;
		top: 0;
		width: 100%;
		height: 100vh;
		overflow: hidden;
		background: var(--color-bg-light);
		box-sizing: border-box;
		/* Shared with .wwd-card's height and .wwd-progress's position below,
		   so the progress bar can be centred against the card's actual
		   (clamped) bottom edge instead of a guessed fixed offset. */
		--wwd-card-h: clamp(22rem, 36vw, 30rem);
	}

	.wwd-card {
		position: absolute;
		/* Pushed down from centre by half the (now permanently docked) nav
		   height, so the card sits closer to the progress bar instead of
		   centring as if the nav weren't there. */
		top: calc(50% + var(--nav-height) / 2);
		left: 50%;
		width: min(92vw, var(--content-width));
		height: var(--wwd-card-h);
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: stretch;
		background: var(--color-graphite);
		border: 1px solid var(--color-border);
		overflow: hidden;
		transform: translate(-50%, -50%) translate(var(--enter-x, 0px), var(--enter-y, 0px));
		transition: transform 650ms cubic-bezier(0.76, 0, 0.24, 1);
	}

	.wwd-card.is-active {
		transform: translate(-50%, -50%);
	}

	/* Only the first card gets a shadow, once locked in, to read as one 3D stack
	   rather than every card individually casting its own. */
	.wwd-card:first-child.is-active {
		box-shadow: 0 40px 80px -20px rgba(20, 16, 8, 0.35);
	}

	.wwd-scroll-hint {
		position: absolute;
		top: calc(50% + var(--nav-height) / 2);
		transform: translateY(-50%);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.35rem;
		z-index: 100;
		transition: opacity 400ms var(--ease-standard);
	}

	.wwd-scroll-hint--left {
		left: clamp(0.75rem, 2.5vw, 2rem);
	}

	.wwd-scroll-hint--right {
		right: clamp(0.75rem, 2.5vw, 2rem);
	}

	.wwd-scroll-hint.is-done {
		opacity: 0;
		pointer-events: none;
	}

	.wwd-scroll-hint__chevron {
		width: 0.85rem;
		height: 0.85rem;
		border-right: 2px solid var(--color-graphite);
		border-bottom: 2px solid var(--color-graphite);
		transform: rotate(45deg);
		opacity: 0.15;
		animation: wwd-chevron-pulse 1.8s ease-in-out infinite;
	}

	@keyframes wwd-chevron-pulse {
		0%,
		100% {
			opacity: 0.15;
		}
		30% {
			opacity: 1;
		}
	}

	.wwd-progress {
		position: absolute;
		left: 50%;
		/* Card's bottom edge sits at 50% + nav-height/2 + card-h/2 (its centred
		   top plus half its own height); centre the progress bar in the gap
		   between that edge and the stage's own bottom edge (100%). */
		top: calc(75% + var(--nav-height) / 4 + var(--wwd-card-h) / 4);
		transform: translate(-50%, -50%);
		display: flex;
		align-items: center;
		gap: var(--space-3);
		z-index: 100;
	}

	.wwd-progress__track {
		width: min(50vw, 20rem);
		height: 8px;
		background: var(--color-graphite);
		border: 1px solid color-mix(in srgb, #fff 25%, transparent);
		overflow: hidden;
	}

	.wwd-progress__fill {
		height: 100%;
		width: 0%;
		background: var(--color-division-design-build);
		transition: width 500ms var(--ease-standard);
	}

	.wwd-progress__label {
		font-size: var(--text-xs);
		font-weight: 700;
		letter-spacing: 0.06em;
		font-variant-numeric: tabular-nums;
		color: var(--color-graphite);
		min-width: 2.6rem;
	}

	.wwd-card--reverse .wwd-card__content {
		order: 2;
	}

	.wwd-card--reverse .wwd-card__media {
		order: 1;
	}

	.wwd-card__content {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: var(--section-pad-y) clamp(2rem, 4vw, 4.5rem);
	}

	/* Pre-Construction Planning: 3-line title needs less top/bottom padding to
	   stay vertically centered inside the fixed card height without overflowing. */
	.wwd-card__content--compact {
		padding-top: calc(var(--section-pad-y) * 0.4);
		padding-bottom: calc(var(--section-pad-y) * 0.4);
	}

	.wwd-card__content::before {
		content: "";
		position: absolute;
		inset: 0;
		background-image: url("/images/UK MAP WHITE.png");
		background-repeat: no-repeat;
		background-position: center;
		background-size: 53.55%;
		opacity: 0.06;
		z-index: -1;
	}

	.wwd-card__eyebrow {
		position: relative;
		display: inline-block;
		width: fit-content;
		font-size: calc(var(--text-xs) * 0.85);
		font-weight: 700;
		letter-spacing: 0.207em;
		text-transform: uppercase;
		color: #fff;
		margin: 0 0 var(--space-4);
	}

	.wwd-card__name {
		font-family: var(--font-display);
		font-size: clamp(1.9rem, 3.2vw, var(--text-3xl));
		text-transform: uppercase;
		line-height: var(--leading-tight);
		color: #fff;
		margin: 0 0 var(--space-3);
	}

	.wwd-card__description {
		font-size: calc(var(--text-lg) * 0.85);
		line-height: var(--leading-normal);
		color: color-mix(in srgb, #fff 70%, transparent);
		margin: 0;
		max-width: 30rem;
	}

	/* Card eyebrow/title/description standard: see docs/brand/text-standards.md */

	.wwd-card__button {
		--btn-pad: 0.75rem 1.5rem;
		position: relative;
		display: inline-flex;
		width: fit-content;
		margin-top: var(--space-4);
		background: var(--color-division-design-build);
		color: #fff;
		text-decoration: none;
		overflow: hidden;
		isolation: isolate;
	}

	.wwd-card__button-bg {
		position: absolute;
		inset: 0;
		width: 2px;
		background: #fff;
		transition: width 350ms var(--ease-standard);
		z-index: 0;
	}

	.wwd-card__button:hover .wwd-card__button-bg,
	.wwd-card__button:focus-visible .wwd-card__button-bg {
		width: 100%;
	}

	.wwd-card__button-edge {
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 2px;
		background: #fff;
		z-index: 2;
		transition: background 350ms var(--ease-standard);
	}

	.wwd-card__button:hover .wwd-card__button-edge,
	.wwd-card__button:focus-visible .wwd-card__button-edge {
		background: var(--color-division-design-build);
	}

	.wwd-card__button-label {
		position: relative;
		z-index: 1;
		display: inline-flex;
		align-items: center;
		font-size: var(--text-xs);
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		padding: var(--btn-pad);
		white-space: nowrap;
		transition: transform 150ms var(--ease-standard), color 350ms var(--ease-standard);
	}

	.wwd-card__button:hover .wwd-card__button-label,
	.wwd-card__button:focus-visible .wwd-card__button-label {
		color: #050505;
	}

	.wwd-card__button:active .wwd-card__button-label {
		transform: scale(0.97);
	}

	.wwd-card__media {
		position: relative;
		z-index: 1;
		height: 100%;
		overflow: hidden;
	}

	.wwd-card__media-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	@media (prefers-reduced-motion: reduce) {
		.wwd-card {
			transform: translate(-50%, -50%) !important;
		}
	}

	@media (max-width: 1024px) {
		.what-we-do__title {
			white-space: normal;
		}

		.what-we-do__track {
			height: auto !important;
		}

		.what-we-do__stage {
			position: relative;
			display: flex;
			flex-direction: column;
			gap: var(--space-6);
			height: auto;
			padding: var(--space-6) var(--space-4);
		}

		.wwd-card {
			position: relative;
			top: auto;
			left: auto;
			width: 100%;
			height: auto;
			grid-template-columns: 1fr;
			grid-template-rows: auto auto;
			transform: none !important;
		}

		.wwd-card__content {
			padding: var(--space-5) var(--space-4);
			order: 2;
		}

		.wwd-card__media {
			height: 16rem;
			order: 1;
		}

		.wwd-progress {
			display: none;
		}

		.wwd-scroll-hint {
			display: none;
		}
	}
</style>

<script>
	const track = document.querySelector<HTMLElement>("[data-wwd-track]");
	const items = document.querySelectorAll<HTMLElement>("[data-wwd-item]");
	const progressFill = document.querySelector<HTMLElement>("[data-wwd-progress-fill]");
	const progressLabel = document.querySelector<HTMLElement>("[data-wwd-progress-label]");
	const scrollHints = document.querySelectorAll<HTMLElement>("[data-wwd-scroll-hint]");
	const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
	const isMobile = window.matchMedia("(max-width: 1024px)").matches;

	if (track && items.length && !reduceMotion && !isMobile) {
		const count = items.length;
		let activeIndex = -1;
		let ticking = false;

		function setActive(index: number) {
			activeIndex = index;
			const percent = Math.round(((activeIndex + 1) / count) * 100);
			items.forEach((item, i) => item.classList.toggle("is-active", i <= activeIndex));
			if (progressFill) progressFill.style.width = `${percent}%`;
			if (progressLabel) progressLabel.textContent = `${activeIndex + 1}/${count}`;
			scrollHints.forEach((hint) => hint.classList.toggle("is-done", activeIndex >= count - 1));
		}

		function update() {
			ticking = false;
			if (!track) return;

			const rect = track.getBoundingClientRect();
			const pinnable = rect.height - window.innerHeight;
			const progress = pinnable > 0 ? Math.min(1, Math.max(0, -rect.top / pinnable)) : rect.top <= 0 ? 1 : 0;

			const bucket = Math.min(count - 1, Math.floor(progress * count));
			if (bucket !== activeIndex) setActive(bucket);
		}

		function onScroll() {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(update);
		}

		window.addEventListener("scroll", onScroll, { passive: true });
		window.addEventListener("resize", onScroll);
		update();
	} else {
		items.forEach((item) => item.classList.add("is-active"));
		if (progressFill) progressFill.style.width = "100%";
		if (progressLabel) progressLabel.textContent = `${items.length}/${items.length}`;
		scrollHints.forEach((hint) => hint.classList.add("is-done"));
	}
</script>
