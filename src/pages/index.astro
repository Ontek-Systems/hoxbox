---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Intro from "../components/Intro.astro";
import WhatWeDo from "../components/WhatWeDo.astro";
import Gallery from "../components/Gallery.astro";
import WhereWeServe from "../components/WhereWeServe.astro";
import Testimonials from "../components/Testimonials.astro";
import Contact from "../components/Contact.astro";
---

<BaseLayout
	title="Hox Box Design & Build"
	description="Integrity, reliability, and performance. Hoxbox Design and Build is Hoxton, London's in-house design and build team, covering pre-construction through handover, fuss-free."
>
	<main>
		<Hero />
		<Intro />
		<WhatWeDo />
		<Gallery />
		<WhereWeServe />
		<Testimonials />
		<Contact />
	</main>
</BaseLayout>
